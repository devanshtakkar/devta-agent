# server
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"  # for CORS + auth redirects

# database — MongoDB Atlas → Connect → Drivers → copy string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/wingman?retryWrites=true&w=majority

# auth — Better-Auth
BETTER_AUTH_SECRET=<run: openssl rand -base64 32>
BETTER_AUTH_URL=http://localhost:3001  # prod: https://api.yourdomain.com

# AI — OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash  # swappable without frontend change
