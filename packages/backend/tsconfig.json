{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // App, not a library: no .d.ts output. (Also avoids TS2883: the admin
    // plugin's inferred types reference zod v4 internals, which aren't
    // portable to declarations.)
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"]
}
